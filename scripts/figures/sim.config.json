{
  "plugins": [
    {
      "name": "Arg",
      "umdUrl": "http://localhost:8899/plugin/jbrowse-plugin-arg.umd.js"
    }
  ],
  "assemblies": [
    {
      "name": "sim",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "sim-ref",
        "adapter": {
          "type": "IndexedFastaAdapter",
          "uri": "data/sim.fa"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "ArgTrack",
      "trackId": "sweep",
      "name": "Simulated: a beneficial mutation swept to fixation at 1 Mb",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "data/sweep.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "ArgTrack",
      "trackId": "introgression",
      "name": "Simulated: population A took in 3% of its DNA from B, 500 generations ago",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "data/introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "FeatureTrack",
      "trackId": "introgression_painting",
      "name": "Simulated introgression, painted by each haplotype's nearest relatives",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "data/introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      },
      "displays": [
        {
          "type": "LinearMultiRowFeatureDisplay",
          "displayId": "introgression_painting-LinearMultiRowFeatureDisplay",
          "rows": "row",
          "height": 280,
          "rowGroups": [
            {
              "match": "^A ",
              "group": "A"
            },
            {
              "match": "^B ",
              "group": "B"
            }
          ],
          "rowColor": {
            "field": "group",
            "domain": ["A", "B"],
            "range": ["#0072b2", "#e69f00"]
          },
          "color": {
            "value": "jexl:get(feature,'color')",
            "scale": "identity",
            "domain": ["#0072b2", "#e69f00"],
            "labels": ["relatives mostly A", "relatives mostly B"]
          }
        }
      ]
    }
  ]
}
