{
  "plugins": [
    {
      "name": "Arg",
      "umdUrl": "http://localhost:8899/plugin/jbrowse-plugin-arg.umd.js"
    }
  ],
  "assemblies": [
    {
      "name": "sim",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "sim-ref",
        "adapter": { "type": "IndexedFastaAdapter", "uri": "data/sim.fa" }
      }
    }
  ],
  "tracks": [
    {
      "type": "ArgTrack",
      "trackId": "sweep",
      "name": "Simulated: a beneficial mutation swept to fixation at 1 Mb",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "data/sweep.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "ArgTrack",
      "trackId": "introgression",
      "name": "Simulated: population A took in 3% of its DNA from B, 500 generations ago",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "data/introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      },
      "displays": [
        {
          "type": "LinearArgDisplay",
          "displayId": "introgression-LinearArgDisplay",
          "drawMode": "painting",
          "height": 280
        }
      ]
    }
  ]
}
