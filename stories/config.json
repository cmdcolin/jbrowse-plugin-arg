{
  "plugins": [
    {
      "name": "Arg",
      "url": "http://localhost:8899/plugin/jbrowse-plugin-arg.umd.js"
    }
  ],
  "assemblies": [
    {
      "name": "sim",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "sim-ref",
        "adapter": { "type": "IndexedFastaAdapter", "uri": "sim.fa" }
      }
    }
  ],
  "tracks": [
    {
      "type": "ArgTrack",
      "trackId": "split",
      "name": "Simulated: populations A and B, isolated for 20,000 generations",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "split.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "ArgTrack",
      "trackId": "introgression",
      "name": "Simulated: population A took in DNA from B 1,000 generations ago",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      },
      "displays": [
        {
          "type": "LinearArgDisplay",
          "displayId": "introgression-LinearArgDisplay",
          "highlightSamples": ["5"]
        }
      ]
    },
    {
      "type": "ArgTrack",
      "trackId": "sweep",
      "name": "Simulated: a beneficial mutation swept to fixation at 1 Mb",
      "assemblyNames": ["sim"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "sweep.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    }
  ]
}
